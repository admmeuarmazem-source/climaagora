# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twilio integration keys for SMS and WhatsApp notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Open-Meteo Weather API Commercial Key (Optional)
# ATTENTION: Open-Meteo free tier is restricted to non-commercial use (CC BY 4.0).
# If launching commercially or monetizing (ads, subscriptions), set your commercial API key here:
OPEN_METEO_API_KEY=""

# RainViewer Radar API Key (Optional)
# ATTENTION: RainViewer public tile service is free ONLY for personal, educational, or small-scale non-commercial use.
# For commercial monetization, app distribution, or high-volume usage, register for a RainViewer API key at https://www.rainviewer.com/api.html:
RAINVIEWER_API_KEY=""

